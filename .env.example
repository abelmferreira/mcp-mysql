# ===========================================
# MCP MySQL - Environment Variables
# ===========================================
#
# Every variable can be given in three ways (highest precedence first):
#   1. the "env" block of the MCP client config (.mcp.json) or the shell;
#   2. a dotenv file pointed to by ENV_FILE (see below);
#   3. `npm start`, which reads ./.env (development only).
# With Docker, pass this file with `docker run --env-file` (no quotes around values).

# -------------------------------------------
# ENV_FILE (OPTIONAL, set it in the MCP client "env" block, not here)
# -------------------------------------------
# Path of a dotenv file with the variables below. Variables already present in
# the environment win over the file. ~ is expanded; relative paths are resolved
# against the working directory. A missing/unreadable file aborts the start.
#   "env": { "ENV_FILE": "/path/to/project/.env" }

# -------------------------------------------
# MySQL Connection
# -------------------------------------------
# You can configure the connection in TWO ways:
#
# OPTION 1: Connection URL (recommended for simplicity)
# OPTION 2: Individual parameters (for more control)
#
# If SQL_CONNECTION_URL is set, it takes precedence over
# individual parameters (SQL_SERVER, SQL_DATABASE, etc.)

# -------------------------------------------
# OPTION 1: Connection URL
# -------------------------------------------
# Format: mysql://user:password@host:port/database?options
#
# Supported query parameters:
#   - ssl=true|false|disable
#
# Examples:
#   SQL_CONNECTION_URL=mysql://app:change-me@localhost:3306/mydb
#   SQL_CONNECTION_URL=mysql://app:change-me@localhost:3306/mydb?ssl=false
#   SQL_CONNECTION_URL=mariadb://reader:change-me@db.example.com:3306/proddb?ssl=true
#
# Special characters in the password must be URL-encoded (e.g. @ -> %40).
#
# SQL_CONNECTION_URL=mysql://app:change-me@localhost:3306/mydb

# -------------------------------------------
# OPTION 2: Individual Parameters
# -------------------------------------------

# MySQL host (IP address or hostname)
SQL_SERVER=localhost

# Database name
SQL_DATABASE=mydb

# MySQL authentication (use an account that only holds SELECT, see README)
SQL_USER=app
SQL_PASSWORD=change-me

# -------------------------------------------
# MySQL Connection (OPTIONAL)
# -------------------------------------------
# These settings apply to both connection methods.
# Note: If using URL, port/ssl are parsed from the URL.

# MySQL port (default: 3306)
SQL_PORT=3306

# Use SSL/TLS connection (default: false). The server certificate is VERIFIED.
SQL_SSL=false

# PEM file with the CA that signed the database certificate (optional; the
# system CA store is used otherwise). ~ is expanded.
# SQL_SSL_CA=~/certs/db-ca.pem

# Certificate verification (default: true). "false" disables it: not
# recommended, the connection is then open to man-in-the-middle attacks.
# SQL_SSL_REJECT_UNAUTHORIZED=true

# -------------------------------------------
# Operation Mode (REQUIRED)
# -------------------------------------------

# READONLY mode controls what operations are allowed:
#   true  = Read-only mode (SELECT queries only)
#   false = Full access mode (SELECT, INSERT, UPDATE, DELETE)
#
# The server will NOT start if this variable is not set.
READONLY=true

# -------------------------------------------
# Performance Settings (OPTIONAL)
# -------------------------------------------

# Statement timeout in milliseconds (default: 30000, max: 120000).
# Enforced by the server (max_statement_time / max_execution_time) and by the client.
QUERY_TIMEOUT=30000

# Maximum rows returned per query (default: 1000, max: 5000)
MAX_ROWS=1000

# Maximum size of one query result in bytes, approximate
# (default: 1048576 = 1 MiB, min: 1024, max: 104857600 = 100 MiB).
# Larger results are cut and flagged "truncated".
# MAX_RESULT_BYTES=1048576

# Maximum connections open on the database at the same time (default: 3, max: 50).
# Queries beyond it wait in a FIFO queue. Keep it below the max_user_connections
# of the database account, leaving room for its other clients; raise it if the
# account allows more connections. (POOL_MIN is no longer used.)
POOL_MAX=3

# -------------------------------------------
# Logging (OPTIONAL)
# -------------------------------------------

# Log level: debug, info, warn, error (default: info)
LOG_LEVEL=info

# -------------------------------------------
# SSH tunnel (OPTIONAL)
# -------------------------------------------
# When SSH_HOST is set the server opens the tunnel itself (no manual `ssh -L`):
# SQL_SERVER:SQL_PORT is then the database address AS SEEN FROM THE SSH HOST.
# SSH_USER, SSH_KEY_PATH and SSH_HOST_FINGERPRINT become mandatory.
# SSH_HOST=bastion.example.com
# SSH_PORT=22
# SSH_USER=tunnel
# Private key path. With npx: a path on this machine (~ is expanded, prefer
# absolute paths). With Docker: the path INSIDE the container (mount it :ro).
# SSH_KEY_PATH=~/.ssh/mcp_tunnel_key
# SSH_KEY_PATH=/run/secrets/ssh_key
# Only for encrypted keys
# SSH_KEY_PASSPHRASE=
# Pinned host key fingerprint(s), comma separated (ssh-keygen -lf <host key .pub>).
# Each one is SHA256: followed by 43 base64 characters; the format is checked at startup.
# SSH_HOST_FINGERPRINT=SHA256:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

